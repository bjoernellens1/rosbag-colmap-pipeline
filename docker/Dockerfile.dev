# ROCm 7.2 + PyTorch base (Ubuntu 24.04, Python 3.12) -- see docker/Dockerfile
# for rationale.
FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-venv \
    python3-pip \
    git \
    cmake \
    build-essential \
    libeigen3-dev \
    libopencv-dev \
    libsqlite3-dev \
    libboost-all-dev \
    libceres-dev \
    libgflags-dev \
    libgoogle-glog-dev \
    curl \
    wget \
    vim \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv --system-site-packages /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN uv pip install --upgrade pip setuptools wheel

RUN apt-get update && apt-get install -y colmap && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/dev.txt /app/requirements/
COPY requirements/base.txt /app/requirements/
RUN uv pip install -r requirements/dev.txt

COPY pyproject.toml /app/
COPY configs/ /app/configs/
COPY src/ /app/src/
COPY tests/ /app/tests/
RUN uv pip install -e ".[depth-ba,dev]"

RUN mkdir -p /app/data/raw /app/data/workspaces /app/data/samples

WORKDIR /app
