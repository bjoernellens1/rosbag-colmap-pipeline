# CUDA-enabled COLMAP build for the cps-gpu-cluster A100 nodes (compute
# capability 8.0, driver 580.95.05, CUDA runtime ceiling 13.0 -- CUDA 12.6
# sits comfortably below that ceiling, same choice splatograph's own
# Dockerfile.cuda made for the identical cluster). `devel`, not `base`/
# `runtime`, because building COLMAP from source needs `nvcc`.
FROM nvcr.io/nvidia/cuda:12.6.0-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Confirmed live (multiple build hangs, each stuck indefinitely on a
# single apt fetch with zero progress/error): this build host has flaky/
# congested routing specifically to Canonical's geo-DNS `archive.ubuntu.
# com`/`security.ubuntu.com` (repeated retries/timeouts on both, on both
# IPv4 and IPv6, at different points) -- while several named mirrors
# (de.archive.ubuntu.com among them, tested to also carry noble-security)
# responded fast and reliably every time. Switch to that specific mirror
# instead of the geo-redirector, and still keep IPv4-forcing + retries as
# defense in depth for whatever flakiness remains.
RUN sed -i 's|archive\.ubuntu\.com|de.archive.ubuntu.com|g; s|security\.ubuntu\.com|de.archive.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources \
    && printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "5";\nAcquire::http::Timeout "15";\nAcquire::https::Timeout "15";\n' > /etc/apt/apt.conf.d/99network-resilience

# Same dependency list as docker/Dockerfile (CPU/ROCm image), INCLUDING
# libceres-dev -- unlike the earlier cuDSS-based attempt, this image does
# NOT build Ceres from source at all. GPU bundle adjustment comes from
# COLMAP's own native "Caspar" solver (COLMAP >=4.1.0, -DCASPAR_ENABLED=ON
# below), which bypasses Ceres/cuDSS entirely -- it's COLMAP's own CUDA
# kernel code (bundled under src/thirdparty/Symforce-Caspar/), not a
# Ceres GPU backend. apt's plain CPU-only Ceres is all COLMAP's own
# Ceres-backed code paths (feature matching geometry, non-BA estimators)
# need; the actual BA hot path uses Caspar instead when requested.
#
# See docs/cluster-dispatch.md's "Ceres+cuDSS" section for why that route
# was abandoned: building Ceres from source (master, unreleased cuDSS
# integration) against NVIDIA cuDSS produced numerically corrupted
# reconstructions on real A100 hardware, confirmed with two different
# cuDSS versions and root-caused (via research) to a documented history
# of cuDSS silent-wrong-answer bugs across that exact version range
# (NVIDIA cuDSS release-notes items CUDSS-882/1003/1020/1292/1293) plus
# Ceres' cuDSS integration itself being unreleased/master-only. Caspar
# sidesteps that whole dependency chain -- it's an officially shipped,
# tagged-release COLMAP feature, not an unreleased Ceres branch.
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-venv \
    python3-pip \
    git \
    cmake \
    ninja-build \
    build-essential \
    libeigen3-dev \
    libopencv-dev \
    libsqlite3-dev \
    libboost-all-dev \
    libgflags-dev \
    libgoogle-glog-dev \
    libatlas-base-dev \
    libsuitesparse-dev \
    libflann-dev \
    libfreeimage-dev \
    libmetis-dev \
    libgtest-dev \
    libgmock-dev \
    libglew-dev \
    qtbase5-dev \
    libqt5opengl5-dev \
    libcgal-dev \
    libcgal-qt5-dev \
    libcurl4-openssl-dev \
    libopenimageio-dev \
    openimageio-tools \
    libceres-dev \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# No ROCm/PyTorch base to inherit site-packages from here (unlike
# docker/Dockerfile) -- a plain venv is enough.
RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN uv pip install --upgrade pip setuptools wheel

# Same COLMAP 4.1.1 source build as docker/Dockerfile, with CUDA enabled
# and the A100's compute capability (8.0) pinned explicitly --
# CMAKE_CUDA_ARCHITECTURES autodetection needs a GPU present at build
# time, which this build host does not have (splatograph hit exactly this
# failure class building its own Dockerfile.cuda for the same cluster).
#
# -DCASPAR_ENABLED=ON: COLMAP's own native GPU bundle-adjustment solver
# (shipped since 4.1.0, bundled thirdparty CUDA kernel source, not a
# Ceres backend) -- select it at runtime with
# --BundleAdjustment.backend CASPAR (standalone bundle_adjuster) or
# --Mapper.ba_local_backend/--Mapper.ba_global_backend CASPAR
# (incremental mapper). Needs no extra apt packages beyond the CUDA
# toolkit already present in this image.
# docker/patches/caspar-opencv/ adds native OPENCV camera-model support to
# Caspar (COLMAP upstream only ships PINHOLE/SIMPLE_RADIAL) -- see that
# directory's README.md for the full derivation/verification writeup.
# Overlaid onto the cloned source before cmake/ninja: the patched
# caspar_generate.py's *output* (generated_f32/, already regenerated on the
# host -- this build does NOT need symforce or re-run codegen), plus the
# small bundle_adjustment_caspar.cc/caspar_model_adapter.h dispatch changes.
COPY docker/patches/caspar-opencv/generated_f32/ /tmp/caspar-opencv-patch/generated_f32/
COPY docker/patches/caspar-opencv/bundle_adjustment_caspar.cc /tmp/caspar-opencv-patch/bundle_adjustment_caspar.cc
COPY docker/patches/caspar-opencv/caspar_model_adapter.h /tmp/caspar-opencv-patch/caspar_model_adapter.h

ARG COLMAP_BUILD_JOBS=
RUN git clone --depth 1 --branch 4.1.1 https://github.com/colmap/colmap.git /opt/colmap_src \
    && rm -rf /opt/colmap_src/src/thirdparty/Symforce-Caspar/generated/f32 \
    && cp -r /tmp/caspar-opencv-patch/generated_f32 \
        /opt/colmap_src/src/thirdparty/Symforce-Caspar/generated/f32 \
    && cp /tmp/caspar-opencv-patch/bundle_adjustment_caspar.cc \
        /opt/colmap_src/src/colmap/estimators/bundle_adjustment_caspar.cc \
    && cp /tmp/caspar-opencv-patch/caspar_model_adapter.h \
        /opt/colmap_src/src/colmap/estimators/caspar/caspar_model_adapter.h \
    && rm -rf /tmp/caspar-opencv-patch \
    && mkdir -p /opt/colmap_src/build \
    && cd /opt/colmap_src/build \
    && cmake .. -GNinja -DCMAKE_BUILD_TYPE=Release -DCUDA_ENABLED=ON \
        -DCMAKE_CUDA_ARCHITECTURES=80 \
        -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
        -DCASPAR_ENABLED=ON \
    && ninja -j "${COLMAP_BUILD_JOBS:-$(nproc)}" \
    && ninja install \
    && rm -rf /opt/colmap_src

# Same vocab tree as docker/Dockerfile -- see that file's comment for why
# this specific (faiss-format) asset, not the older flann-format one.
RUN mkdir -p /opt/colmap_vocab_tree && \
    curl -fsSL -o /opt/colmap_vocab_tree/vocab_tree_flickr100K_words32K.bin \
    https://github.com/colmap/colmap/releases/download/3.11.1/vocab_tree_faiss_flickr100K_words32K.bin

WORKDIR /app

COPY requirements/base.txt /app/requirements/
RUN uv pip install -r requirements/base.txt

COPY pyproject.toml /app/
COPY configs/ /app/configs/
COPY src/ /app/src/
RUN uv pip install -e ".[depth-ba]"

LABEL org.opencontainers.image.source="https://github.com/bjoernellens1/rosbag-colmap-pipeline" \
      org.opencontainers.image.description="CUDA-enabled COLMAP build for A100 cluster dispatch (cps-gpu-cluster)" \
      org.opencontainers.image.licenses="MIT"

ENTRYPOINT ["gttool"]
CMD ["--help"]
