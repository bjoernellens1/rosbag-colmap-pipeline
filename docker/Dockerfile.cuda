# CUDA-enabled COLMAP build for the cps-gpu-cluster A100 nodes (compute
# capability 8.0, driver 580.95.05, CUDA runtime ceiling 13.0 -- CUDA 12.6
# sits comfortably below that ceiling, same choice splatograph's own
# Dockerfile.cuda made for the identical cluster). `devel`, not `base`/
# `runtime`, because building COLMAP from source needs `nvcc`.
FROM nvcr.io/nvidia/cuda:12.6.0-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Confirmed live (multiple build hangs, each stuck indefinitely on a
# single apt fetch with zero progress/error): this build host has flaky/
# congested routing specifically to Canonical's geo-DNS `archive.ubuntu.
# com`/`security.ubuntu.com` (repeated retries/timeouts on both, on both
# IPv4 and IPv6, at different points) -- while several named mirrors
# (de.archive.ubuntu.com among them, tested to also carry noble-security)
# responded fast and reliably every time. Switch to that specific mirror
# instead of the geo-redirector, and still keep IPv4-forcing + retries as
# defense in depth for whatever flakiness remains.
RUN sed -i 's|archive\.ubuntu\.com|de.archive.ubuntu.com|g; s|security\.ubuntu\.com|de.archive.ubuntu.com|g' /etc/apt/sources.list.d/ubuntu.sources \
    && printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "5";\nAcquire::http::Timeout "15";\nAcquire::https::Timeout "15";\n' > /etc/apt/apt.conf.d/99network-resilience

# Same dependency list as docker/Dockerfile (CPU/ROCm image), MINUS
# libceres-dev -- apt's Ceres is CPU-only (no CUDA, no cuDSS), so it's
# built from source below instead for genuine GPU-accelerated bundle
# adjustment (not just GPU feature extraction/matching).
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-venv \
    python3-pip \
    git \
    cmake \
    ninja-build \
    build-essential \
    libeigen3-dev \
    libopencv-dev \
    libsqlite3-dev \
    libboost-all-dev \
    libgflags-dev \
    libgoogle-glog-dev \
    libatlas-base-dev \
    libsuitesparse-dev \
    libflann-dev \
    libfreeimage-dev \
    libmetis-dev \
    libgtest-dev \
    libgmock-dev \
    libglew-dev \
    qtbase5-dev \
    libqt5opengl5-dev \
    libcgal-dev \
    libcgal-qt5-dev \
    libcurl4-openssl-dev \
    libopenimageio-dev \
    openimageio-tools \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# NVIDIA cuDSS (CUDA Direct Sparse Solver) -- Ceres 2.2+'s GPU sparse
# Cholesky backend for bundle adjustment needs this specifically; CUDA
# toolkit alone only gets Ceres' GPU DENSE solver, not sparse (confirmed
# live: "Ceres was compiled without cuDSS support. Falling back to
# CPU-based sparse solvers." on an earlier CUDA-only build of this image).
#
# PINNED to 0.3.0.9 via NVIDIA's direct tarball, NOT apt's current
# 0.8.0.10 -- apt's latest silently produced a CORRUPTED reconstruction
# (confirmed live on a real scene: trajectory fragmented into 39
# disconnected segments up to 81m apart) with a self-contradictory Ceres
# log line ("Linear solver failure. Failed to compute a step: Success.").
# Root-caused via deep research, not guessed: Ceres master's cuDSS
# integration (still unreleased -- no tagged release has cuDSS support at
# all, see ceres-solver/ceres-solver#1161) is only ever CI-tested against
# cuDSS 0.3.0.9 (see ceres-solver's own .github/workflows/linux.yml,
# which fetches exactly this tarball/version) -- apt's 0.8.0.10 is five
# minor versions past anything Ceres' integration code has ever been
# validated against, no version pin/check exists in Ceres' CMakeLists.txt
# to catch the mismatch. A related open upstream bug
# (ceres-solver/ceres-solver#1079) documents cuDSS persisting numerical-
# factorization-error state across calls unless the whole cuDSS context is
# reset -- plausible contributor, unverified against 0.8.x. The tarball's
# own directory layout (include/, lib/, lib/cmake/cudss/) also matches
# what cudss-config.cmake expects natively -- no header-path workaround
# needed here, unlike the apt .deb's non-matching Debian FHS layout.
RUN wget -q https://developer.download.nvidia.com/compute/cudss/redist/libcudss/linux-x86_64/libcudss-linux-x86_64-0.3.0.9_cuda12-archive.tar.xz \
    && mkdir -p /opt/cudss \
    && tar -xf libcudss-linux-x86_64-0.3.0.9_cuda12-archive.tar.xz -C /opt/cudss --strip-components=1 \
    && rm libcudss-linux-x86_64-0.3.0.9_cuda12-archive.tar.xz \
    && echo /opt/cudss/lib > /etc/ld.so.conf.d/cudss.conf \
    && ldconfig \
    # cuDSS's shipped cudss-config-version.cmake doesn't correctly report
    # its own version to CMake's find_package version-compatibility check
    # (confirmed live: COLMAP's build failed with "Could not find a
    # configuration file for package cudss that is compatible with
    # requested version 0.3.0" / "version: unknown" even though the exact
    # right package IS present at that exact path) -- a known class of
    # issue with this vendor's cmake packaging (see ceres-solver/
    # ceres-solver#1125, #1151). Replace it with a minimal, always-
    # compatible version file -- safe here since we control both sides
    # (Ceres was built against this exact cuDSS install already).
    && printf 'set(PACKAGE_VERSION "0.3.0.9")\nset(PACKAGE_VERSION_EXACT FALSE)\nset(PACKAGE_VERSION_COMPATIBLE TRUE)\nset(PACKAGE_VERSION_UNSUITABLE FALSE)\n' \
       > /opt/cudss/lib/cmake/cudss/cudss-config-version.cmake

# Ceres Solver built from source with CUDA (dense) + cuDSS (sparse) GPU
# solver support -- apt's libceres-dev has neither. Bundled abseil-cpp/
# googletest (Ceres' own third_party/ submodule pins) instead of a plain
# `git submodule update`, matching the exact recipe that's confirmed to
# build cleanly against COLMAP 4.1.1's Ceres API expectations.
# FIXED: an initially-pinned older commit (93e66f0d) predates a cuDSS API
# break (cudaDataType_t -> cudssDataType_t, cuDSS support isn't in any
# tagged Ceres release yet, only >=2.2.0's unstable branch) -- confirmed
# live: it failed to compile against apt's current cuDSS (0.8.0.10) with
# exactly that type-mismatch error. Track master instead, which follows
# cuDSS's current API.
ARG CERES_BUILD_JOBS=
RUN git clone https://github.com/ceres-solver/ceres-solver.git /opt/ceres_src \
    && cd /opt/ceres_src \
    && cd third_party \
    && rm -rf abseil-cpp googletest \
    && git clone -b 20250127.1 --depth 1 https://github.com/abseil/abseil-cpp.git \
    && git clone -b v1.16.0 --depth 1 https://github.com/google/googletest.git \
    && cd /opt/ceres_src \
    && mkdir build && cd build \
    && cmake .. -GNinja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=80 \
        -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
        -Dcudss_DIR=/opt/cudss/lib/cmake/cudss/ \
    && ninja -j "${CERES_BUILD_JOBS:-$(nproc)}" \
    && ninja install \
    && rm -rf /opt/ceres_src

# No ROCm/PyTorch base to inherit site-packages from here (unlike
# docker/Dockerfile) -- a plain venv is enough.
RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN uv pip install --upgrade pip setuptools wheel

# Same COLMAP 4.1.1 source build as docker/Dockerfile, with CUDA enabled
# and the A100's compute capability (8.0) pinned explicitly --
# CMAKE_CUDA_ARCHITECTURES autodetection needs a GPU present at build
# time, which this build host does not have (splatograph hit exactly this
# failure class building its own Dockerfile.cuda for the same cluster).
ARG COLMAP_BUILD_JOBS=
RUN git clone --depth 1 --branch 4.1.1 https://github.com/colmap/colmap.git /opt/colmap_src \
    && mkdir -p /opt/colmap_src/build \
    && cd /opt/colmap_src/build \
    && cmake .. -GNinja -DCMAKE_BUILD_TYPE=Release -DCUDA_ENABLED=ON \
        -DCMAKE_CUDA_ARCHITECTURES=80 \
        -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
        -Dcudss_DIR=/opt/cudss/lib/cmake/cudss/ \
    && ninja -j "${COLMAP_BUILD_JOBS:-$(nproc)}" \
    && ninja install \
    && rm -rf /opt/colmap_src

# Same vocab tree as docker/Dockerfile -- see that file's comment for why
# this specific (faiss-format) asset, not the older flann-format one.
RUN mkdir -p /opt/colmap_vocab_tree && \
    curl -fsSL -o /opt/colmap_vocab_tree/vocab_tree_flickr100K_words32K.bin \
    https://github.com/colmap/colmap/releases/download/3.11.1/vocab_tree_faiss_flickr100K_words32K.bin

WORKDIR /app

COPY requirements/base.txt /app/requirements/
RUN uv pip install -r requirements/base.txt

COPY pyproject.toml /app/
COPY configs/ /app/configs/
COPY src/ /app/src/
RUN uv pip install -e ".[depth-ba]"

LABEL org.opencontainers.image.source="https://github.com/bjoernellens1/rosbag-colmap-pipeline" \
      org.opencontainers.image.description="CUDA-enabled COLMAP build for A100 cluster dispatch (cps-gpu-cluster)" \
      org.opencontainers.image.licenses="MIT"

ENTRYPOINT ["gttool"]
CMD ["--help"]
